{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:unit": "node -e \"import('node:fs').then(({readdirSync})=>import('node:child_process').then(({execFileSync})=>{const files=readdirSync('tests').filter(f=>f.endsWith('.test.js')&&!f.includes('.integration.')&&!f.startsWith('real-db')&&f!=='trust-penalty-integration.test.js').map(f=>'tests/'+f);execFileSync(process.execPath,['--test',...files],{stdio:'inherit'});}))\"",
    "migrate": "node src/scripts/migrate.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "test:integration": "node --test tests/api-*.integration.test.js tests/trust-penalty-integration.test.js tests/real-db*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}
